{
  "name": "sketchdown",
  "version": "0.1.0",
  "description": "Balsamiq-style wireframes for Excalidraw inside Obsidian",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cheatsheet": "node scripts/cheatsheet.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "roughjs": "^4.6.6"
  }
}
